# ── LLM Gateway V3 ──────────────────────────────────────────────────────────
GATEWAY_V3_PORT=8101

# ── Provider keys — fill in the ones you have ───────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_MODEL=gemma4:e4b
OLLAMA_URL=http://localhost:11434

# ── MCP server keys ─────────────────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here

# ── Placeholder keys (fill if available) ────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

CEREBRAS_API_KEY=
CEREBRAS_MODEL=zai-glm-4.7

OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

GITHUB_ACCESS_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini

# ── Worker failover order ────────────────────────────────────────────────────
# Original default: ollama,gemini,nvidia,groq,cerebras,openrouter,github
# Updated: Gemini first (large context), Cerebras second (60K TPM free),
# Groq third, then NVIDIA/OpenRouter/GitHub, Ollama last (local fallback)
LLM_ORDER=gemini,cerebras,groq,nvidia,openrouter,github,ollama

# ── Router pool (routing-decision LLMs — smaller/faster) ────────────────────
# Original default: groq,nvidia,cerebras,github
ROUTER_ORDER=cerebras,groq,nvidia,github
ROUTER_GROQ_MODEL=llama-3.3-70b-versatile
ROUTER_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
ROUTER_CEREBRAS_MODEL=llama3.1-8b
ROUTER_GITHUB_MODEL=microsoft/Phi-4-mini-instruct
